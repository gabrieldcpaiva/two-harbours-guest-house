---
import '../styles/global.css';
import site from '../data/site.json';
import BookingButton from '../components/BookingButton.astro';

interface Props { title: string; description: string; path: string; }
const { title, description, path } = Astro.props;
const canonical = new URL(path, Astro.site).href;
const isActive = (href: string) => path === href;
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Two Harbours Guest House</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${title} · Two Harbours Guest House`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_GB" />
    <meta name="theme-color" content="#f5f4ef" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/cormorant-garamond-500.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/dm-sans-400.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline src="/scripts/site.js" defer></script>
    <noscript><style>@media(max-width:63.999rem){.menu-toggle{display:none}.site-header__inner{flex-wrap:wrap;padding-block:.75rem}.primary-nav{display:block;position:static;padding:0;border:0;box-shadow:none;width:100%}.primary-nav ul{display:flex;flex-wrap:wrap;gap:.5rem 1rem;margin:0 0 .75rem}.primary-nav a:not(.button){min-height:2.5rem;border:0}.header-booking{width:auto}}</style></noscript>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header" data-header>
      <div class="site-header__inner container">
        <a class="wordmark" href="/">
          <svg class="wordmark__mark" viewBox="0 0 44 32" aria-hidden="true" focusable="false">
            <path d="M3 12c5-5 10-5 15 0s10 5 15 0 8-4 8-4M3 21c5-5 10-5 15 0s10 5 15 0 8-4 8-4" />
          </svg>
          <span>Two Harbours<small>Scalpay · Isle of Harris</small></span>
        </a>
        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="primary-navigation" data-menu-toggle>
          <span class="menu-toggle__lines" aria-hidden="true"><i></i><i></i></span>
          <span data-menu-label>Menu</span>
        </button>
        <nav class="primary-nav" id="primary-navigation" aria-label="Primary" data-menu>
          <ul>
            {site.navigation.map((item) => (
              <li><a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a></li>
            ))}
          </ul>
          <BookingButton className="button--small header-booking" />
        </nav>
      </div>
    </header>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container">
        <div class="site-footer__top">
          <div class="site-footer__brand">
            <p class="wordmark wordmark--footer">Two Harbours<small>Scalpay · Isle of Harris</small></p>
            <p class="site-footer__line">A house between harbours.<br />A welcome that has lasted.</p>
          </div>
          <div>
            <h2 class="footer-heading">Find us</h2>
            <address>{site.address.map((line) => <span>{line}<br /></span>)}</address>
            <p class="placeholder">[Full postal address / street line to be confirmed]</p>
          </div>
          <div>
            <h2 class="footer-heading">Speak to us</h2>
            <a href={site.phoneHref}>{site.phone}</a><br />
            <a href={`mailto:${site.email}`}>{site.email}</a>
            <p class="footer-licence">Short-term let licence<br />{site.licence}</p>
          </div>
          <div>
            <h2 class="footer-heading">Your stay</h2>
            <ul class="footer-links">
              {site.navigation.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
              <li><a href={site.bookingUrl} target="_blank" rel="noopener noreferrer">Book direct <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span></a></li>
            </ul>
          </div>
        </div>
        <div class="site-footer__bottom">
          <p>© {new Date().getFullYear()} Two Harbours Guest House.</p>
          <ul class="legal-links" aria-label="Legal">
            <li><a href="/privacy/">Privacy <span class="sr-only">[placeholder]</span></a></li>
            <li><a href="/terms/">Terms <span class="sr-only">[placeholder]</span></a></li>
            <li><a href="/accessibility/">Accessibility <span class="sr-only">[placeholder]</span></a></li>
          </ul>
        </div>
      </div>
    </footer>
  </body>
</html>
