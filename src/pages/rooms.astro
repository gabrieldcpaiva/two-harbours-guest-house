---
import Base from '../layouts/Base.astro';
import Picture from '../components/Picture.astro';
import BookingButton from '../components/BookingButton.astro';
import SectionHeading from '../components/SectionHeading.astro';
import site from '../data/site.json';
const r = site.rooms;
---
<Base title="Rooms & stay" description="Luskentyre, Scarista and Borve: three en-suite rooms at Two Harbours on Scalpay, with breakfast included, harbour or garden views and published 2026–2027 rates." path="/rooms/">
  <section class="page-intro">
    <div class="container page-intro__grid">
      <div><p class="eyebrow">Rooms & stay</p><h1>{r.title}</h1><p class="lead">{r.intro}</p></div>
      <div class="page-intro__aside"><p>All rooms are up one flight of stairs. Maximum two adults per room. Check-in is {site.policies.checkIn}; check-out {site.policies.checkOut.toLowerCase()}.</p><p style="margin-top:1rem"><BookingButton label="Check availability" className="button--small" /></p></div>
    </div>
  </section>

  <section class="container" aria-label="The three rooms">
    {r.items.map((room) => (
      <article class="room-detail" id={room.name.toLowerCase()} aria-labelledby={`${room.name.toLowerCase()}-title`}>
        <Picture name={room.image} alt={room.alt} widths={[460, 800, 1200, 1600]} sizes="(min-width: 64rem) 53vw, 100vw" className="room-detail__image" />
        <div>
          <p class="room-detail__number">{room.number}</p>
          <h2 id={`${room.name.toLowerCase()}-title`}>{room.name}</h2>
          <p class="room-detail__kind">{room.kind}</p>
          <p class="room-detail__description">{room.description}</p>
          <ul class="feature-list">{room.features.map((feature) => <li>{feature}</li>)}</ul>
          <p class="rate-line">2026 from <strong>£{room.rates['2026'].long}</strong> / night for 2+ nights<span>One night £{room.rates['2026'].single} · 2027 from £{room.rates['2027'].long} for 2+ nights</span></p>
        </div>
      </article>
    ))}
  </section>

  <section class="section section--paper" aria-labelledby="included-title">
    <div class="container">
      <SectionHeading eyebrow="Part of the stay" title="The small things are already there." id="included-title" />
      <ul class="included-grid">{r.included.map((item) => <li>{item}</li>)}</ul>
      <details class="details-panel">
        <summary>Rates, occupancy and payment</summary>
        <div class="details-panel__body">
          <p>{r.rateNote}</p>
          <div class="rate-table-wrap" tabindex="0" role="region" aria-label="Room rates, scrollable on small screens">
            <table class="rate-table">
              <caption>Published room rates, February–November</caption>
              <thead><tr><th scope="col">Room</th><th scope="col">2026 · 2+ nights</th><th scope="col">2026 · 1 night</th><th scope="col">2027 · 2+ nights</th><th scope="col">2027 · 1 night</th></tr></thead>
              <tbody>{r.items.map((room) => <tr><th scope="row">{room.name}</th><td>£{room.rates['2026'].long}</td><td>£{room.rates['2026'].single}</td><td>£{room.rates['2027'].long}</td><td>£{room.rates['2027'].single}</td></tr>)}</tbody>
            </table>
          </div>
          <p style="margin-top:1rem">{site.policies.deposit} {site.policies.hold}</p>
        </div>
      </details>
      <details class="details-panel" open>
        <summary>Before you reserve</summary>
        <div class="details-panel__body">
          <p>{site.policies.occupancy}. {site.policies.children}. {site.policies.pets}. {site.policies.smoking}.</p>
          <p>{site.policies.dietary} {site.policies.food}</p>
          <p><span class="placeholder">{r.placeholders.accessibility}</span></p>
        </div>
      </details>
      <details class="details-panel" open>
        <summary>Optional extras</summary>
        <div class="details-panel__body">
          <p>Evening lite-bites can be ordered by WhatsApp; packed lunches and an optional wash-and-fold laundry service are available. Wine, beer, Isle of Harris Gin and Hearach single malt are offered. Safe bike storage and a boot dryer are provided.</p>
          <p><span class="placeholder">{r.placeholders.liteBitePrices}</span> <span class="placeholder">{r.placeholders.laundryPrices}</span></p>
          <p>The 7kW EV charger is reserved for exclusive use at booking. You pay only for electricity used, at cost, settled on departure. <span class="placeholder">{r.placeholders.evPrice}</span></p>
        </div>
      </details>
      <details class="details-panel" open>
        <summary>Room details still to confirm</summary>
        <div class="details-panel__body"><p><span class="placeholder">{r.placeholders.roomSize}</span> <span class="placeholder">{r.placeholders.bedDimensions}</span></p></div>
      </details>
    </div>
  </section>

  <section class="section closing" aria-labelledby="rooms-closing-title">
    <div class="container--narrow"><h2 id="rooms-closing-title">Chosen your outlook?</h2><p>Check the house’s live availability and reserve directly. Single-night stays are requests, not instant confirmations.</p><BookingButton label="Check dates & book direct" /></div>
  </section>
</Base>
