---
import Base from '../layouts/Base.astro';
import Picture from '../components/Picture.astro';
import BookingButton from '../components/BookingButton.astro';
import TextLink from '../components/TextLink.astro';
import SectionHeading from '../components/SectionHeading.astro';
import site from '../data/site.json';
const h = site.home;
---
<Base title="A Hebridean welcome on Scalpay" description="Two Harbours Boutique Guest House: three en-suite rooms between Scalpay’s two harbours, with breakfast included and Harris and Lewis close at hand. Book direct." path="/">
  <section class="hero" aria-labelledby="hero-title">
    <Picture name={h.hero.image} alt={h.hero.alt} priority widths={[640, 960, 1220]} sizes="100vw" className="hero__image" />
    <div class="hero__content">
      <p class="eyebrow">{h.hero.eyebrow}</p>
      <h1 id="hero-title">{h.hero.title}</h1>
      <p class="hero__intro">{h.hero.intro}</p>
      <div class="hero__actions"><BookingButton label="Book your stay direct" /></div>
    </div>
    <p class="hero__caption">{h.hero.caption}</p>
  </section>

  <section class="section" aria-labelledby="stay-title">
    <div class="container statement-grid">
      <SectionHeading eyebrow={h.statement.eyebrow} title={h.statement.title} id="stay-title" />
      <div class="prose">{h.statement.paragraphs.map((p) => <p>{p}</p>)}</div>
    </div>
  </section>

  <section class="section section--paper" aria-labelledby="rooms-title">
    <div class="container">
      <div class="statement-grid">
        <SectionHeading eyebrow={h.roomsIntro.eyebrow} title={h.roomsIntro.title} id="rooms-title" />
        <div class="prose"><p>{h.roomsIntro.text}</p><TextLink href="/rooms/">See the three rooms</TextLink></div>
      </div>
      <div class="room-preview">
        {site.rooms.items.map((room) => (
          <article class="room-card">
            <a href={`/rooms/#${room.name.toLowerCase()}`} aria-label={`Read about the ${room.name} room`}>
              <Picture name={room.image} alt={room.alt} widths={[460, 800, 1200]} sizes="(min-width: 64rem) 30vw, 100vw" className="room-card__image" />
            </a>
            <p class="room-card__meta">{room.kind}</p>
            <h3><a href={`/rooms/#${room.name.toLowerCase()}`}>{room.name}</a></h3>
            <p>{room.distinct}</p>
            <p class="room-card__price">From <strong>£{room.rates['2026'].long}</strong> per night · 2+ nights, 2026</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="breakfast-title">
    <div class="container split">
      <Picture name="dining" alt="The breakfast room laid with wooden tables, place settings and a painted Hebridean landscape around the walls." widths={[460, 800]} sizes="(min-width: 64rem) 48vw, 100vw" className="split__image" />
      <div class="split__copy">
        <SectionHeading eyebrow="From the farmhouse kitchen" title="Breakfast is not an afterthought." id="breakfast-title" />
        <div class="prose"><p>An indulgent breakfast is included, freshly prepared from locally sourced produce. Choose traditional Scottish favourites or a daily special such as Scalpay Eggs Benedict. Homemade bread appears alongside; nobody is trying to rush you out of the door.</p></div>
        <p class="note" style="margin-top:1rem"><span class="placeholder">{site.rooms.placeholders.breakfastTimes}</span></p>
      </div>
    </div>
  </section>

  <section class="section band--dark" aria-labelledby="history-title">
    <div class="container split split--reverse">
      <Picture name="sunset" alt="Evening light over Scalpay’s rocky shore and the water, with hills silhouetted beyond." widths={[376]} sizes="(min-width: 64rem) 48vw, 100vw" className="split__image" />
      <div class="split__copy">
        <SectionHeading eyebrow={h.houseIntro.eyebrow} title={h.houseIntro.title} id="history-title" />
        <div class="prose"><p>{h.houseIntro.text}</p></div>
        <blockquote class="quote-block"><p>“{h.houseIntro.quote}”</p><cite>{h.houseIntro.attribution}</cite></blockquote>
        <TextLink href="/the-house/">Read the house story</TextLink>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="island-title">
    <div class="container split">
      <Picture name="bridge" alt="Scalpay Bridge crossing blue water between low, rocky island shores under a wide sky." widths={[454]} sizes="(min-width: 64rem) 48vw, 100vw" className="split__image" />
      <div class="split__copy">
        <SectionHeading eyebrow={h.islandIntro.eyebrow} title={h.islandIntro.title} id="island-title" />
        <div class="prose"><p>{h.islandIntro.text}</p></div>
        <TextLink href="/getting-here/">Plan the journey</TextLink>
      </div>
    </div>
  </section>

  <section class="section section--paper closing" aria-labelledby="closing-title">
    <div class="container--narrow">
      <h2 id="closing-title">{h.closing.title}</h2>
      <p>{h.closing.text}</p>
      <BookingButton label="Book direct with the house" />
    </div>
  </section>
</Base>
